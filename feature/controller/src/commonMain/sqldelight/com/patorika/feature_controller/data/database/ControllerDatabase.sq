CREATE TABLE controllers (
  id TEXT NOT NULL PRIMARY KEY,
  name TEXT NOT NULL,
  orientation TEXT NOT NULL
);

CREATE TABLE elements (
  id TEXT NOT NULL PRIMARY KEY,
  parent_id TEXT NOT NULL,
  type TEXT NOT NULL,
  jsonVersion INTEGER NOT NULL DEFAULT 1,
  json TEXT NOT NULL,

  FOREIGN KEY(parent_id)
    REFERENCES controllers(id)
    ON DELETE CASCADE
    ON UPDATE CASCADE
);

CREATE INDEX elements_parent_idx
ON elements(parent_id);

getAllControllers:
SELECT
    c.id AS controllerId,
    c.name,
    c.orientation,
    e.id AS elementId,
    e.parent_id AS parentId,
    e.type,
    e.jsonVersion,
    e.json
FROM controllers AS c
LEFT JOIN elements AS e ON e.parent_id = c.id;

getControllerById:
SELECT
    c.id AS controllerId,
    c.name,
    c.orientation,
    e.id AS elementId,
    e.parent_id AS parentId,
    e.type,
    e.jsonVersion,
    e.json
FROM controllers AS c
LEFT JOIN elements AS e ON e.parent_id = c.id
WHERE c.id = :id;

insertController:
INSERT OR REPLACE
INTO controllers(id, name, orientation)
VALUES(?, ?, ?);

insertElement:
INSERT OR REPLACE
INTO elements(id, parent_id, type, jsonVersion, json)
VALUES(?, ?, ?, ?, ?);

removeController:
DELETE FROM controllers
WHERE id = :id;
